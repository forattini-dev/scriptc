{
  "name": "importmapped",
  "version": "1.0.0",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "imports": {
    "#exact": "./internal/exact.js",
    "#pattern/*": "./internal/*.js",
    "#condition": {
      "browser": "./internal/browser.js",
      "node": "./internal/node.js",
      "default": "./internal/default.js"
    },
    "#mode": {
      "import": "./internal/import-mode.js",
      "require": "./internal/require-mode.cjs"
    },
    "#external": "dual"
  }
}
