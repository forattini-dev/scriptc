type JsonPrimitive = string | number | boolean | null;
type JsonObject = { [key: string]: JsonValue | undefined };
type JsonArray = JsonValue[] | readonly JsonValue[];
export type JsonValue = JsonPrimitive | JsonObject | JsonArray;
export interface DecodeOptions { strict?: boolean; }
declare function decodeValue(input: string, options?: DecodeOptions): JsonValue;
export declare const decode: typeof decodeValue;

// An unused, unsupported export must not leak provisional native layouts into
// the valid recursive contract collected from this same declaration module.
interface Unsupported {
  self: Unsupported;
  invalid: Map<string, number> | string;
}
export declare function unused(input: Unsupported): void;
