{
  "name": "@scriptc/runtime-rust",
  "version": "0.1.1-rust.0",
  "description": "Memory-safe Rust runtime for the scriptc Rust backend",
  "license": "Apache-2.0",
  "homepage": "https://scriptc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/scriptc.git",
    "directory": "packages/runtime-rust"
  },
  "files": [
    "Cargo.lock",
    "Cargo.toml",
    "island-v8/Cargo.lock",
    "island-v8/Cargo.toml",
    "island-v8/src",
    "src",
    "vendor/url",
    "vendor/boa_ast",
    "vendor/boa_engine",
    "vendor/boa_gc",
    "vendor/boa_parser"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "cargo check --manifest-path Cargo.toml",
    "test": "cargo test --locked --manifest-path Cargo.toml",
    "lint": "cargo clippy --all-targets --locked --manifest-path Cargo.toml -- -D warnings"
  }
}
